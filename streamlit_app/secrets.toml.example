# Copy to .streamlit/secrets.toml (gitignored) and fill in.
# Never commit real passwords or API keys.
#
# Local tunnel (bastion port-forward): leave TRIALMATCH_API_KEY empty unless
# the GKE API has TRIALMATCH_API_KEY set.
#
# Streamlit Cloud (public Ingress): set BASE_URL to http://<ingress-ip> (or
# https://your-domain) and TRIALMATCH_API_KEY to the same value as GKE.

DEMO_GUEST_USERNAME = "guest"
DEMO_GUEST_PASSWORD = "change-me"
TRIALMATCH_API_BASE_URL = "http://127.0.0.1:18080"
TRIALMATCH_API_KEY = ""
