# Copy to terraform.tfvars (gitignored) before plan/apply.
# Project ID is not a secret; never put service-account keys here.

project_id   = "autonomous-agent-503517"
region       = "us-central1"
network_name = "trialmatch-vpc"
subnet_name  = "trialmatch-private"
subnet_cidr  = "10.10.0.0/20"
nat_ip_count = 2

cluster_name            = "trialmatch-gke"
master_ipv4_cidr_block  = "172.16.0.0/28"
gke_node_count          = 1
gke_machine_type        = "e2-standard-2"
gke_disk_size_gb        = 30
gke_disk_type           = "pd-standard"
gke_deletion_protection = false
artifact_repository_id  = "trialmatch-docker"
ksa_name                = "trialmatch-ksa"
ksa_namespace           = "trialmatch"

clinical_topic_name        = "clinical-records"
lab_topic_name             = "lab-updates"
clinical_subscription_name = "clinical-records-sub"
lab_subscription_name      = "lab-updates-sub"

secret_ids = [
  "trialmatch-snowflake-private-key",
  "trialmatch-snowflake-passphrase",
  "trialmatch-api-key",
]

ingress_address_name = "trialmatch-ingress-ip"
ingress_domain       = ""

# Private bastion + IAP (required for kubectl from outside the VPC)
bastion_name         = "trialmatch-bastion"
bastion_zone         = "us-central1-a"
bastion_machine_type = "e2-micro"
# Replace with your Google account(s):
bastion_iap_members = [
  "user:YOU@example.com",
]
