# EXAMPLE ONLY — do not commit real key material.
# Copy to secret-api-key.yaml (gitignored locally) or apply from bastion after editing.
#
#   KEY="$(openssl rand -hex 32)"
#   kubectl -n trialmatch create secret generic trialmatch-api-key \
#     --from-literal=api-key="$KEY" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# Prefer Secret Manager shell `trialmatch-api-key` (Terraform secret_ids) and sync
# a Kubernetes Secret for the Deployment env (see docs/runbooks/public-api-streamlit-cloud.md).
apiVersion: v1
kind: Secret
metadata:
  name: trialmatch-api-key
  namespace: trialmatch
  labels:
    app.kubernetes.io/name: trialmatch-api
type: Opaque
stringData:
  api-key: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
