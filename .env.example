# Example environment variables for local development.
# Copy to `.env` (gitignored) and adjust. Never commit real secrets.

# GCP project for this engine (not a secret; do not hardcode in Python modules)
GCP_PROJECT_ID=autonomous-agent-503517

ENVIRONMENT=dev
LOG_LEVEL=INFO

# OpenTelemetry (Phase 1.5) — leave endpoint empty for local/unit (no remote export)
OTEL_SERVICE_NAME=trialmatch
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional downstream targets (filled in later phases)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trial_criteria
# Embeddings: deterministic (local/tests) | vertex (ADC on GCP)
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
PUBSUB_CLINICAL_TOPIC=clinical-records
PUBSUB_LAB_TOPIC=lab-updates
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=TRIALMATCH_WH
SNOWFLAKE_DATABASE=TRIALMATCH_DEV
SNOWFLAKE_SCHEMA=MARTS
# Path to private key PEM on disk (fetch from Secret Manager; never commit the key)
SNOWFLAKE_PRIVATE_KEY_PATH=
AGENT_READ_ROLE=AGENT_READ_ROLE
AUDIT_WRITE_ROLE=AUDIT_WRITE_ROLE

# LLM for Parser agent (Phase 8)
# LLM_PROVIDER=ollama (local, $0 tokens) | vertex (GCP Vertex, billed)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1:8b
# Vertex (only when LLM_PROVIDER=vertex) — ADC / Workload Identity; never API keys
VERTEX_LLM_MODEL=gemini-2.0-flash-001
VERTEX_LLM_LOCATION=us-central1
