# Example environment variables for local development.
# Copy to `.env` (gitignored) and adjust. Never commit real secrets.

# GCP project for this engine (not a secret; do not hardcode in Python modules)
GCP_PROJECT_ID=autonomous-agent-503517

ENVIRONMENT=dev
LOG_LEVEL=INFO

# OpenTelemetry (Phase 1.5) — leave endpoint empty for local/unit (no remote export)
OTEL_SERVICE_NAME=trialmatch
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional downstream targets (filled in later phases)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=trial_criteria
PUBSUB_CLINICAL_TOPIC=clinical-records
PUBSUB_LAB_TOPIC=lab-updates
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
AGENT_READ_ROLE=AGENT_READ_ROLE
AUDIT_WRITE_ROLE=AUDIT_WRITE_ROLE
